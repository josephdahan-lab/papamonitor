[Unit]
Description=papaMonitor System Monitor
After=network.target

[Service]
Type=simple
User=joseph
Environment=HOME=/home/joseph
WorkingDirectory=/home/joseph/monitor
ExecStart=/bin/bash /home/joseph/monitor/monitor.sh
# WiFi watchdog needs CAP_NET_ADMIN to bring wlan0 down/up.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
Restart=always
RestartSec=10
StandardOutput=append:/home/joseph/monitor/monitor-service.log
StandardError=append:/home/joseph/monitor/monitor-service.log

[Install]
WantedBy=multi-user.target
