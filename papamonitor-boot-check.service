[Unit]
Description=papaMonitor boot classifier (USER_REBOOT / KERNEL_CRASH / POWER_ISSUE / etc)
# After-the-fact analysis of the previous boot's journal — needs the
# journal to be readable and the persistent on-disk store mounted.
After=systemd-journald.service
Requires=systemd-journald.service

[Service]
Type=oneshot
User=joseph
Environment=HOME=/home/joseph
WorkingDirectory=/home/joseph/monitor
ExecStart=/bin/bash /home/joseph/monitor/boot_check.sh
# joseph isn't in the systemd-journal group on every host, so let the
# unit read the journal explicitly.
SupplementaryGroups=systemd-journal
RemainAfterExit=no
StandardOutput=append:/home/joseph/monitor/monitor-service.log
StandardError=append:/home/joseph/monitor/monitor-service.log

[Install]
WantedBy=multi-user.target
